# Slim variant: no LibreOffice, fonts, aria2, or media/thumbnail tooling.
# Packages the goreleaser-built `cloudreve` binary from the build context.

FROM alpine:latest

WORKDIR /cloudreve

RUN apk update \
    && apk add --no-cache tzdata \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

COPY cloudreve ./cloudreve

RUN chmod +x ./cloudreve

EXPOSE 5212

VOLUME ["/cloudreve/data"]

ENTRYPOINT ["./cloudreve"]
