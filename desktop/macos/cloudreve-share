#!/bin/sh
# cloudreve-share — open the Cloudreve share dialog for local file(s).
# macOS counterpart of desktop/linux/cloudreve-share; usable from Terminal:
#   cloudreve-share ~/Cloudreve/report.pdf
# or from a Finder Quick Action (see README.md in this directory).
#
# Works whether the app is running or not — the app bundle registers the
# cloudreve:// scheme and processes share deep links passed at cold start.

set -eu

for f in "$@"; do
    encoded=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$f")
    open "cloudreve://share/$encoded"
done
